# Supabase
SUPABASE_URL=https://your-project.supabase.co
PUBLISHABLE_KEY=your-publishable-key
# Configure one of these for JWT verification in NestJS:
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Database
# Runtime Prisma connection (can be pooled connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blocknet
# Migration connection (prefer direct/non-pooled Supabase URL)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/blocknet

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# App
NODE_ENV=development
PORT=3080
# Comma-separated list of extra allowed CORS origins (for deployed admin/landing)
CORS_ORIGINS=https://your-admin.railway.app,https://your-landing.com

# Seed bootstrap (optional)
OWNER_USER_ID=
OWNER_EMAIL=

# Wallet + BNT (BSC)
WALLET_ENABLED=false
DEPOSITS_ENABLED=false
WITHDRAWALS_ENABLED=false
WALLET_CHAIN_ENVIRONMENT=testnet
# In non-production seeds/backfills, true marks wallets as ready with deterministic mock addresses.
WALLET_SEED_READY_MOCK=true

BSC_RPC_TESTNET=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_RPC_MAINNET=https://bsc-dataseed.binance.org
BSC_CHAIN_ID_TESTNET=97
BSC_CHAIN_ID_MAINNET=56

TURNKEY_BASE_URL=https://api.turnkey.com
TURNKEY_DEV_MOCK=false
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_PRIVATE_KEY_ID=

BNT_TOKEN_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
BNT_TOKEN_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
TREASURY_WALLET_ID_TESTNET=
TREASURY_WALLET_ID_MAINNET=
