# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Configure one of these for JWT verification in NestJS:
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Database
# Runtime Prisma connection (can be pooled connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blocknet
# Migration connection (prefer direct/non-pooled Supabase URL)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/blocknet

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# App
NODE_ENV=development
PORT=3080

# Seed bootstrap (optional)
OWNER_USER_ID=
OWNER_EMAIL=
