generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  owner
  admin
  hunter
  user
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum ApplicationTargetRole {
  admin
  hunter
}

enum ProjectStatus {
  active
  paused
  archived
}

enum UpdateStatus {
  published
  archived
}

enum UpdateUrgency {
  high
  medium
  low
}

enum NotificationType {
  project_update
  system
}

enum CommunityTopic {
  general
  market_talk
  introductions
}

enum CommunityReactionKind {
  like
}

enum InviteStatus {
  pending
  accepted
  rejected
  cancelled
}

enum ProjectProposalStatus {
  pending
  approved
  rejected
}

model Profile {
  id                String             @id @db.Uuid
  email             String             @unique
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roles             UserRole[]
  ownedProjects     Project[]          @relation("OwnedProjects")
  hunterAssignments ProjectHunter[]
  authoredUpdates   Update[]           @relation("AuthoredUpdates")
  authoredComments  Comment[]          @relation("AuthoredComments")
  communityPosts    CommunityPost[]    @relation("CommunityPostAuthor")
  communityPostComments CommunityPostComment[] @relation("CommunityPostCommentAuthor")
  communityPostReactions CommunityPostReaction[] @relation("CommunityPostReactionUser")
  bookmarks         Bookmark[]
  followerLinks     UserFollow[]       @relation("UserFollowFollowee")
  followingLinks    UserFollow[]       @relation("UserFollowFollower")
  hunterInvites     ProjectHunterInvite[] @relation("InviteHunter")
  sentInvites       ProjectHunterInvite[] @relation("InviteSender")
  reviewedInvites   ProjectHunterInvite[] @relation("InviteReviewer")
  projectProposals  ProjectProposal[]     @relation("ProjectProposalApplicant")
  reviewedProposals ProjectProposal[]     @relation("ProjectProposalReviewer")
  follows           ProjectFollow[]
  notifications     Notification[]
  deviceTokens      DeviceToken[]
  adminApplications AdminApplication[] @relation("AdminApplicationApplicant")
  audits            AuditLog[]         @relation("ActorAuditLogs")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      RoleName
  grantedBy String?  @db.Uuid
  createdAt DateTime @default(now())

  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model Project {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  slug          String          @unique
  normalizedName String?        @unique
  symbol        String?         @unique
  websiteUrl    String?
  websiteDomain String?         @unique
  description   String
  primaryTagId  String          @db.Uuid
  status        ProjectStatus   @default(active)
  ownerAdminId  String          @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ownerAdmin    Profile         @relation("OwnedProjects", fields: [ownerAdminId], references: [id])
  primaryTag    PrimaryTag      @relation(fields: [primaryTagId], references: [id], onDelete: Restrict)
  secondaryTags ProjectSecondaryTag[]
  hunters       ProjectHunter[]
  invites       ProjectHunterInvite[]
  proposals     ProjectProposal[]
  updates       Update[]
  follows       ProjectFollow[]
  notifications Notification[]

  @@index([ownerAdminId])
}

model ProjectHunter {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  hunterId   String   @db.Uuid
  assignedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hunter     Profile  @relation(fields: [hunterId], references: [id], onDelete: Cascade)

  @@unique([projectId, hunterId])
  @@index([hunterId])
}

model ProjectHunterInvite {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  hunterId    String       @db.Uuid
  invitedBy   String       @db.Uuid
  note        String?
  status      InviteStatus @default(pending)
  reviewedBy  String?      @db.Uuid
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hunter      Profile      @relation("InviteHunter", fields: [hunterId], references: [id], onDelete: Cascade)
  inviter     Profile      @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  reviewer    Profile?     @relation("InviteReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, hunterId])
  @@index([hunterId, status])
  @@index([projectId, status])
}

model ProjectProposal {
  id             String               @id @default(uuid()) @db.Uuid
  applicantId    String               @db.Uuid
  name           String
  normalizedName String
  symbol         String?
  websiteUrl     String?
  websiteDomain  String?
  description    String
  primaryTagId   String               @db.Uuid
  reason         String?
  status         ProjectProposalStatus @default(pending)
  reviewerId     String?              @db.Uuid
  reviewNote     String?
  reviewedAt     DateTime?
  createdProjectId String?            @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  applicant      Profile              @relation("ProjectProposalApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer       Profile?             @relation("ProjectProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdProject Project?             @relation(fields: [createdProjectId], references: [id], onDelete: SetNull)
  primaryTag     PrimaryTag           @relation(fields: [primaryTagId], references: [id], onDelete: Restrict)

  @@index([applicantId, status])
  @@index([status, createdAt])
  @@index([normalizedName, status])
}

model Update {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @db.Uuid
  authorId      String          @db.Uuid
  urgency       UpdateUrgency
  title         String
  contentMd     String
  status        UpdateStatus    @default(published)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        Profile         @relation("AuthoredUpdates", fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]
  comments      Comment[]
  secondaryTags UpdateSecondaryTag[]

  @@index([projectId, urgency])
  @@index([authorId])
}

model PrimaryTag {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  projects    Project[]
  proposals   ProjectProposal[]
}

model SecondaryTag {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  slug        String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  projects    ProjectSecondaryTag[]
  updates     UpdateSecondaryTag[]
}

model ProjectSecondaryTag {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @db.Uuid
  secondaryTagId String       @db.Uuid
  createdAt      DateTime     @default(now())

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secondaryTag   SecondaryTag @relation(fields: [secondaryTagId], references: [id], onDelete: Restrict)

  @@unique([projectId, secondaryTagId])
  @@index([secondaryTagId])
}

model UpdateSecondaryTag {
  id             String       @id @default(uuid()) @db.Uuid
  updateId       String       @db.Uuid
  secondaryTagId String       @db.Uuid
  createdAt      DateTime     @default(now())

  update         Update       @relation(fields: [updateId], references: [id], onDelete: Cascade)
  secondaryTag   SecondaryTag @relation(fields: [secondaryTagId], references: [id], onDelete: Restrict)

  @@unique([updateId, secondaryTagId])
  @@index([secondaryTagId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  updateId  String   @db.Uuid
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author    Profile  @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([updateId, createdAt])
  @@index([authorId])
}

model ProjectFollow {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model UserFollow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @db.Uuid
  followeeId String   @db.Uuid
  createdAt  DateTime @default(now())

  follower   Profile  @relation("UserFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   Profile  @relation("UserFollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model CommunityPost {
  id         String          @id @default(uuid()) @db.Uuid
  authorId   String          @db.Uuid
  topic      CommunityTopic  @default(general)
  content    String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  author     Profile         @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments   CommunityPostComment[]
  reactions  CommunityPostReaction[]
  bookmarks  Bookmark[]

  @@index([topic, createdAt])
  @@index([authorId, createdAt])
}

model CommunityPostComment {
  id         String        @id @default(uuid()) @db.Uuid
  postId     String        @db.Uuid
  authorId   String        @db.Uuid
  content    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     Profile       @relation("CommunityPostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model CommunityPostReaction {
  id         String                @id @default(uuid()) @db.Uuid
  postId     String                @db.Uuid
  userId     String                @db.Uuid
  kind       CommunityReactionKind @default(like)
  createdAt  DateTime              @default(now())

  post       CommunityPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       Profile               @relation("CommunityPostReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, kind])
  @@index([userId, createdAt])
  @@index([postId, kind])
}

model Bookmark {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  communityPostId String        @db.Uuid
  createdAt       DateTime      @default(now())

  user            Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)

  @@unique([userId, communityPostId])
  @@index([userId, createdAt])
  @@index([communityPostId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  type         NotificationType
  projectId    String?         @db.Uuid
  updateId     String?         @db.Uuid
  urgency      UpdateUrgency?
  title        String
  body         String
  isRead       Boolean         @default(false)
  readAt       DateTime?
  createdAt    DateTime        @default(now())

  user         Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  update       Update?         @relation(fields: [updateId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId])
}

model DeviceToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  token       String   @unique
  platform    String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminApplication {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  targetRole  ApplicationTargetRole @default(admin)
  reason      String
  status      ApplicationStatus     @default(pending)
  reviewedBy  String?               @db.Uuid
  reviewedAt  DateTime?
  createdAt   DateTime              @default(now())

  user        Profile               @relation("AdminApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId      String? @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor        Profile? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}
