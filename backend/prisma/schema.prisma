generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  owner
  admin
  moderator
  core_team
  hunter
  user
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum ApplicationTargetRole {
  admin
  hunter
}

enum ProjectStatus {
  active
  paused
  hidden
  archived
}

enum UpdateStatus {
  published
  hidden
  archived
}

enum UpdateUrgency {
  high
  medium
  low
}

enum NotificationType {
  project_update
  profile_followed
  profile_unfollowed
  project_followed
  project_unfollowed
  community_liked
  community_bookmarked
  comment_received
  mention_received
  project_proposal_submitted
  project_proposal_reviewed
  admin_application_submitted
  admin_application_reviewed
  project_invite_received
  project_invite_responded
  project_assignment_changed
  role_changed
  wallet_transfer_sent
  wallet_transfer_received
  wallet_deposit_credited
  wallet_withdrawal_requested
  wallet_withdrawal_approved
  wallet_withdrawal_rejected
  wallet_withdrawal_broadcasted
  wallet_withdrawal_confirmed
  wallet_withdrawal_reverted
  wallet_kyc_reviewed
  wallet_provision_ready
  wallet_provision_failed
  mining_claimed
  referral_bound
  referral_admin_bound
  badge_earned
  quest_completed
  quest_verified
  quest_rejected
  system
}

enum NotificationCategory {
  updates
  social
  governance
  wallet
  mining_referrals
  rewards
  system
}

enum DigestCadence {
  daily
  weekly
}

enum CommunityTopic {
  general
  market_talk
  introductions
}

enum CommunityReactionKind {
  like
}

enum InviteStatus {
  pending
  accepted
  rejected
  cancelled
}

enum ProjectProposalStatus {
  pending
  approved
  rejected
}

enum ContentModerationStatus {
  active
  hidden
  archived
}

enum ChainEnvironment {
  testnet
  mainnet
}

enum WalletProvider {
  turnkey
}

enum WalletStatus {
  provisioning
  ready
  error
  disabled
}

enum WalletAsset {
  BNT
  BNB
  USDT
}

enum WalletAssetKind {
  erc20
  native
}

enum LedgerAccountType {
  user
  treasury
  fee
  hold
}

enum LedgerReason {
  deposit_credit
  deposit_sweep
  internal_transfer
  withdrawal_hold
  withdrawal_finalize
  withdrawal_reject_release
  withdrawal_fee
  manual_adjustment
}

enum OnchainDepositStatus {
  detected
  credited
  swept
  ignored
  failed
}

enum SweepJobStatus {
  queued
  processing
  completed
  failed
}

enum WithdrawalStatus {
  requested
  pending_review
  approved
  rejected
  broadcasting
  confirmed
  failed
  reverted
}

enum KycStatus {
  not_submitted
  pending
  approved
  rejected
}

enum MiningPointSource {
  cycle_claim
  admin_adjustment
  quest_reward
}

enum BadgeCategory {
  engagement
  mining
  social
  trust
  special
}

enum BadgeRarity {
  common
  rare
  epic
  legendary
}

enum QuestType {
  external_link
  internal_action
  social_media
}

enum QuestStatus {
  not_started
  in_progress
  pending_verification
  completed
}

enum QuestVerificationStatus {
  pending
  approved
  rejected
}

enum TipCurrencyKind {
  points
  token
}

enum TipAccountType {
  user
  fee_vault
}

enum TipTransactionType {
  tip
  conversion
  adjustment
}

enum EdgeAction {
  act
  watch
  ignore
}

model Profile {
  id                              String                               @id @db.Uuid
  email                           String                               @unique
  username                        String?                              @unique
  displayName                     String?
  avatarUrl                       String?
  bio                             String?
  isDeactivated                   Boolean                              @default(false)
  deactivatedAt                   DateTime?
  deactivatedBy                   String?                              @db.Uuid
  deactivationReason              String?
  previousUsername                String?
  previousDisplayName             String?
  previousAvatarUrl               String?
  previousBio                     String?
  homeFeedLastSeenAt              DateTime?
  referralCode                    String?                              @unique
  referredById                    String?                              @db.Uuid
  referredAt                      DateTime?
  miningClaimedPoints             BigInt                               @default(0)
  primaryBadgeId                  String?                              @db.Uuid
  createdAt                       DateTime                             @default(now())
  updatedAt                       DateTime                             @updatedAt
  roles                           UserRole[]
  ownedProjects                   Project[]                            @relation("OwnedProjects")
  hunterAssignments               ProjectHunter[]
  authoredUpdates                 Update[]                             @relation("AuthoredUpdates")
  authoredComments                Comment[]                            @relation("AuthoredComments")
  moderatedProjects               Project[]                            @relation("ProjectModerator")
  moderatedUpdates                Update[]                             @relation("UpdateModerator")
  moderatedComments               Comment[]                            @relation("CommentModerator")
  communityPosts                  CommunityPost[]                      @relation("CommunityPostAuthor")
  moderatedCommunityPosts         CommunityPost[]                      @relation("CommunityPostModerator")
  communityPostComments           CommunityPostComment[]               @relation("CommunityPostCommentAuthor")
  moderatedCommunityPostComments  CommunityPostComment[]               @relation("CommunityPostCommentModerator")
  communityPostReactions          CommunityPostReaction[]              @relation("CommunityPostReactionUser")
  bookmarks                       Bookmark[]
  followerLinks                   UserFollow[]                         @relation("UserFollowFollowee")
  followingLinks                  UserFollow[]                         @relation("UserFollowFollower")
  hunterInvites                   ProjectHunterInvite[]                @relation("InviteHunter")
  sentInvites                     ProjectHunterInvite[]                @relation("InviteSender")
  reviewedInvites                 ProjectHunterInvite[]                @relation("InviteReviewer")
  projectProposals                ProjectProposal[]                    @relation("ProjectProposalApplicant")
  reviewedProposals               ProjectProposal[]                    @relation("ProjectProposalReviewer")
  follows                         ProjectFollow[]
  notifications                   Notification[]
  notificationSettings            UserNotificationSettings?
  notificationCategoryPreferences UserNotificationCategoryPreference[]
  notificationTypeOverrides       UserNotificationTypeOverride[]
  actorNotifications              Notification[]                       @relation("NotificationActor")
  deviceTokens                    DeviceToken[]
  adminApplications               AdminApplication[]                   @relation("AdminApplicationApplicant")
  wallet                          UserWallet?
  ledgerAccounts                  LedgerAccount[]
  kycProfile                      KycProfile?
  withdrawalRequests              WithdrawalRequest[]                  @relation("WithdrawalRequester")
  reviewedWithdrawals             WithdrawalRequest[]                  @relation("WithdrawalReviewer")
  reviewedKycProfiles             KycProfile[]                         @relation("KycReviewer")
  tipAccounts                     TipAccount[]
  tipTransactionsSent             TipTransaction[]                     @relation("TipTxnSenderUser")
  tipTransactionsReceived         TipTransaction[]                     @relation("TipTxnRecipientUser")
  tipConversions                  TipConversion[]
  edgeDecisions                   EdgeDecision[]
  edgeFeedback                    EdgeFeedback[]
  audits                          AuditLog[]                           @relation("ActorAuditLogs")
  adminTotpCredential             AdminTotpCredential?
  adminTotpRecoveryCodes          AdminTotpRecoveryCode[]
  adminTwoFactorSessions          AdminTwoFactorSession[]
  adminTotpEnrollmentChallenge    AdminTotpEnrollmentChallenge?
  referrer                        Profile?                             @relation("ProfileReferrer", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                       Profile[]                            @relation("ProfileReferrer")
  miningSessions                  MiningSession[]
  miningPointLedgerEntries        MiningPointLedger[]
  miningHourlyCheckpoints         MiningHourlyCheckpoint[]
  primaryBadge                    Badge?                               @relation("ProfilePrimaryBadge", fields: [primaryBadgeId], references: [id], onDelete: SetNull)
  earnedBadges                    UserBadge[]                          @relation("UserEarnedBadges")
  grantedBadges                   UserBadge[]                          @relation("BadgeGrantor")
  userQuests                      UserQuest[]
  questSubmissions                QuestSubmission[]
  mentions                        Mention[]                        @relation("UserMentioned")
  blockedUsers                    UserBlock[]                      @relation("BlockerUser")
  blockedByUsers                  UserBlock[]                      @relation("BlockedUser")

  @@index([referredById])
  @@index([primaryBadgeId])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  reason    String?
  createdAt DateTime @default(now())

  blocker Profile @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      RoleName
  grantedBy String?  @db.Uuid
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  normalizedName   String?       @unique
  symbol           String?       @unique
  websiteUrl       String?
  websiteDomain    String?       @unique
  description      String
  primaryTagId     String        @db.Uuid
  status           ProjectStatus @default(active)
  moderatedBy      String?       @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  ownerAdminId     String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ownerAdmin    Profile               @relation("OwnedProjects", fields: [ownerAdminId], references: [id])
  moderator     Profile?              @relation("ProjectModerator", fields: [moderatedBy], references: [id], onDelete: SetNull)
  primaryTag    PrimaryTag            @relation(fields: [primaryTagId], references: [id], onDelete: Restrict)
  secondaryTags ProjectSecondaryTag[]
  hunters       ProjectHunter[]
  invites       ProjectHunterInvite[]
  proposals     ProjectProposal[]
  updates       Update[]
  follows       ProjectFollow[]
  edgeDecisions EdgeDecision[]
  notifications Notification[]

  @@index([ownerAdminId])
  @@index([status, createdAt])
}

model ProjectHunter {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  hunterId   String   @db.Uuid
  assignedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hunter  Profile @relation(fields: [hunterId], references: [id], onDelete: Cascade)

  @@unique([projectId, hunterId])
  @@index([hunterId])
}

model ProjectHunterInvite {
  id         String       @id @default(uuid()) @db.Uuid
  projectId  String       @db.Uuid
  hunterId   String       @db.Uuid
  invitedBy  String       @db.Uuid
  note       String?
  status     InviteStatus @default(pending)
  reviewedBy String?      @db.Uuid
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hunter   Profile  @relation("InviteHunter", fields: [hunterId], references: [id], onDelete: Cascade)
  inviter  Profile  @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  reviewer Profile? @relation("InviteReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, hunterId])
  @@index([hunterId, status])
  @@index([projectId, status])
}

model ProjectProposal {
  id               String                @id @default(uuid()) @db.Uuid
  applicantId      String                @db.Uuid
  name             String
  normalizedName   String
  symbol           String?
  websiteUrl       String?
  websiteDomain    String?
  description      String
  primaryTagId     String                @db.Uuid
  reason           String?
  status           ProjectProposalStatus @default(pending)
  reviewerId       String?               @db.Uuid
  reviewNote       String?
  reviewedAt       DateTime?
  createdProjectId String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  applicant      Profile    @relation("ProjectProposalApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer       Profile?   @relation("ProjectProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdProject Project?   @relation(fields: [createdProjectId], references: [id], onDelete: SetNull)
  primaryTag     PrimaryTag @relation(fields: [primaryTagId], references: [id], onDelete: Restrict)

  @@index([applicantId, status])
  @@index([status, createdAt])
  @@index([normalizedName, status])
}

model Update {
  id               String        @id @default(uuid()) @db.Uuid
  projectId        String        @db.Uuid
  authorId         String        @db.Uuid
  urgency          UpdateUrgency
  title            String
  contentMd        String
  status           UpdateStatus  @default(published)
  moderatedBy      String?       @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        Profile              @relation("AuthoredUpdates", fields: [authorId], references: [id], onDelete: Cascade)
  moderator     Profile?             @relation("UpdateModerator", fields: [moderatedBy], references: [id], onDelete: SetNull)
  notifications Notification[]
  comments      Comment[]
  secondaryTags UpdateSecondaryTag[]
  edgeDecisions EdgeDecision[]

  @@index([projectId, urgency])
  @@index([authorId])
  @@index([status, createdAt])
}

model PrimaryTag {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  projects  Project[]
  proposals ProjectProposal[]
}

model SecondaryTag {
  id        String                @id @default(uuid()) @db.Uuid
  name      String                @unique
  slug      String                @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  projects  ProjectSecondaryTag[]
  updates   UpdateSecondaryTag[]
}

model ProjectSecondaryTag {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  secondaryTagId String   @db.Uuid
  createdAt      DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secondaryTag SecondaryTag @relation(fields: [secondaryTagId], references: [id], onDelete: Restrict)

  @@unique([projectId, secondaryTagId])
  @@index([secondaryTagId])
}

model UpdateSecondaryTag {
  id             String   @id @default(uuid()) @db.Uuid
  updateId       String   @db.Uuid
  secondaryTagId String   @db.Uuid
  createdAt      DateTime @default(now())

  update       Update       @relation(fields: [updateId], references: [id], onDelete: Cascade)
  secondaryTag SecondaryTag @relation(fields: [secondaryTagId], references: [id], onDelete: Restrict)

  @@unique([updateId, secondaryTagId])
  @@index([secondaryTagId])
}

model Comment {
  id               String                  @id @default(uuid()) @db.Uuid
  updateId         String                  @db.Uuid
  authorId         String                  @db.Uuid
  content          String
  status           ContentModerationStatus @default(active)
  moderatedBy      String?                 @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  update    Update    @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author    Profile   @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)
  moderator Profile?  @relation("CommentModerator", fields: [moderatedBy], references: [id], onDelete: SetNull)
  mentions  Mention[] @relation("CommentMentions")

  @@index([updateId, status, createdAt])
  @@index([authorId])
  @@index([status, createdAt])
}

model ProjectFollow {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @db.Uuid
  userId          String        @db.Uuid
  alertMinUrgency UpdateUrgency @default(low)
  mutedUntil      DateTime?
  createdAt       DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, alertMinUrgency])
  @@index([projectId, mutedUntil])
}

model UserFollow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @db.Uuid
  followeeId String   @db.Uuid
  createdAt  DateTime @default(now())

  follower Profile @relation("UserFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee Profile @relation("UserFollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model CommunityPost {
  id               String                  @id @default(uuid()) @db.Uuid
  authorId         String                  @db.Uuid
  topic            CommunityTopic          @default(general)
  content          String
  status           ContentModerationStatus @default(active)
  moderatedBy      String?                 @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  author    Profile                 @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderator Profile?                @relation("CommunityPostModerator", fields: [moderatedBy], references: [id], onDelete: SetNull)
  comments  CommunityPostComment[]
  reactions CommunityPostReaction[]
  bookmarks Bookmark[]
  mentions  Mention[]               @relation("CommunityPostMentions")

  @@index([topic, status, createdAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model CommunityPostComment {
  id               String                  @id @default(uuid()) @db.Uuid
  postId           String                  @db.Uuid
  authorId         String                  @db.Uuid
  content          String
  status           ContentModerationStatus @default(active)
  moderatedBy      String?                 @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Profile       @relation("CommunityPostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderator Profile?      @relation("CommunityPostCommentModerator", fields: [moderatedBy], references: [id], onDelete: SetNull)
  mentions  Mention[]     @relation("CommunityPostCommentMentions")

  @@index([postId, status, createdAt])
  @@index([authorId])
  @@index([status, createdAt])
}

model CommunityPostReaction {
  id        String                @id @default(uuid()) @db.Uuid
  postId    String                @db.Uuid
  userId    String                @db.Uuid
  kind      CommunityReactionKind @default(like)
  createdAt DateTime              @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user Profile       @relation("CommunityPostReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, kind])
  @@index([userId, createdAt])
  @@index([postId, kind])
}

model Bookmark {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  communityPostId String   @db.Uuid
  createdAt       DateTime @default(now())

  user          Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityPost CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)

  @@unique([userId, communityPostId])
  @@index([userId, createdAt])
  @@index([communityPostId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  actorUserId String?          @db.Uuid
  projectId   String?          @db.Uuid
  updateId    String?          @db.Uuid
  urgency     UpdateUrgency?
  title       String
  body        String
  payload     Json?
  deeplink    String?
  dedupeKey   String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor   Profile? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  update  Update?  @relation(fields: [updateId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
  @@index([projectId])
}

model UserNotificationSettings {
  userId             String        @id @db.Uuid
  masterEnabled      Boolean       @default(true)
  digestEmailEnabled Boolean       @default(true)
  digestCadence      DigestCadence @default(daily)
  digestHourLocal    Int           @default(8)
  digestMinuteLocal  Int           @default(0)
  timezone           String        @default("UTC")
  lastDigestSentAt   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotificationCategoryPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId, category])
}

model UserNotificationTypeOverride {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  enabled   Boolean
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, type])
}

model EdgeDecision {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String     @db.Uuid
  decisionId         String
  updateId           String     @db.Uuid
  projectId          String     @db.Uuid
  edgeScore          Float
  recommendedAction  EdgeAction
  reasonCodes        Json?
  explanationPreview String?
  urgencyScore       Float
  recencyScore       Float
  relevanceScore     Float
  noveltyScore       Float
  penaltyScore       Float
  generatedAt        DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  update    Update         @relation(fields: [updateId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedbacks EdgeFeedback[]

  @@unique([userId, decisionId])
  @@index([userId, generatedAt])
  @@index([projectId, generatedAt])
  @@index([updateId, generatedAt])
  @@index([recommendedAction, generatedAt])
}

model EdgeFeedback {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @db.Uuid
  decisionRecordId String     @db.Uuid
  decisionId       String
  action           EdgeAction
  context          Json?
  createdAt        DateTime   @default(now())

  user     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision EdgeDecision @relation(fields: [decisionRecordId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([decisionRecordId, createdAt])
  @@index([decisionId, createdAt])
}

model EdgeConfig {
  id        String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminApplication {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @db.Uuid
  targetRole ApplicationTargetRole @default(admin)
  reason     String
  status     ApplicationStatus     @default(pending)
  reviewedBy String?               @db.Uuid
  reviewedAt DateTime?
  createdAt  DateTime              @default(now())

  user Profile @relation("AdminApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor Profile? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}

model UserWallet {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @unique @db.Uuid
  provider               WalletProvider   @default(turnkey)
  providerWalletId       String?          @unique
  chainEnvironment       ChainEnvironment @default(testnet)
  chainId                Int
  address                String?          @unique
  status                 WalletStatus     @default(provisioning)
  lastProvisionAttemptAt DateTime?
  provisionedAt          DateTime?
  failureReason          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user               Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerAccounts     LedgerAccount[]
  deposits           OnchainDeposit[]
  sweepJobs          SweepJob[]
  withdrawalRequests WithdrawalRequest[]

  @@index([status, createdAt])
  @@index([chainEnvironment, status, createdAt])
}

model LedgerAccount {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String?           @db.Uuid
  walletId    String?           @db.Uuid
  accountType LedgerAccountType @default(user)
  currency    String            @default("BNT")
  available   Decimal           @default(0) @db.Decimal(38, 18)
  pending     Decimal           @default(0) @db.Decimal(38, 18)
  locked      Decimal           @default(0) @db.Decimal(38, 18)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user          Profile?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  wallet        UserWallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  debitEntries  LedgerEntry[] @relation("LedgerDebitAccount")
  creditEntries LedgerEntry[] @relation("LedgerCreditAccount")

  @@unique([userId, accountType, currency])
  @@index([accountType, currency])
  @@index([userId, currency])
  @@index([walletId, accountType, currency])
}

model LedgerEntry {
  id              String       @id @default(uuid()) @db.Uuid
  debitAccountId  String       @db.Uuid
  creditAccountId String       @db.Uuid
  amount          Decimal      @db.Decimal(38, 18)
  feeAmount       Decimal      @default(0) @db.Decimal(38, 18)
  reason          LedgerReason
  idempotencyKey  String       @unique
  referenceId     String?
  metadata        Json?
  createdAt       DateTime     @default(now())

  debitAccount           LedgerAccount       @relation("LedgerDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount          LedgerAccount       @relation("LedgerCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  creditedDeposit        OnchainDeposit?
  holdForWithdrawals     WithdrawalRequest[] @relation("WithdrawalHoldEntry")
  finalizeForWithdrawals WithdrawalRequest[] @relation("WithdrawalFinalizeEntry")

  @@index([reason, createdAt])
  @@index([debitAccountId, createdAt])
  @@index([creditAccountId, createdAt])
}

model OnchainDeposit {
  id                    String               @id @default(uuid()) @db.Uuid
  walletId              String               @db.Uuid
  asset                 WalletAsset          @default(BNT)
  assetKind             WalletAssetKind      @default(erc20)
  tokenAddress          String?
  fromAddress           String
  toAddress             String
  amount                Decimal              @db.Decimal(38, 18)
  txHash                String
  logIndex              Int
  blockNumber           BigInt
  confirmations         Int                  @default(0)
  status                OnchainDepositStatus @default(detected)
  creditedLedgerEntryId String?              @unique @db.Uuid
  sweepJobId            String?              @unique @db.Uuid
  idempotencyKey        String               @unique
  detectedAt            DateTime             @default(now())
  creditedAt            DateTime?
  sweptAt               DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  wallet              UserWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  creditedLedgerEntry LedgerEntry? @relation(fields: [creditedLedgerEntryId], references: [id], onDelete: SetNull)
  sweepJob            SweepJob?    @relation(fields: [sweepJobId], references: [id], onDelete: SetNull)

  @@unique([txHash, logIndex, asset])
  @@index([status, createdAt])
  @@index([asset, status, createdAt])
  @@index([walletId, status, createdAt])
  @@index([walletId, asset, status, createdAt])
}

model SweepJob {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @db.Uuid
  asset          WalletAsset     @default(BNT)
  assetKind      WalletAssetKind @default(erc20)
  tokenAddress   String?
  fromAddress    String
  toAddress      String
  amount         Decimal         @db.Decimal(38, 18)
  status         SweepJobStatus  @default(queued)
  attemptCount   Int             @default(0)
  txHash         String?         @unique
  idempotencyKey String          @unique
  failureReason  String?
  scheduledAt    DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  wallet  UserWallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  deposit OnchainDeposit?

  @@index([status, createdAt])
  @@index([asset, status, createdAt])
  @@index([walletId, status, createdAt])
  @@index([walletId, asset, status, createdAt])
}

model WithdrawalRequest {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @db.Uuid
  walletId              String           @db.Uuid
  asset                 WalletAsset      @default(BNT)
  toAddress             String
  amount                Decimal          @db.Decimal(38, 18)
  feeAmount             Decimal          @default(0) @db.Decimal(38, 18)
  netAmount             Decimal          @db.Decimal(38, 18)
  status                WithdrawalStatus @default(requested)
  reason                String
  rejectReason          String?
  idempotencyKey        String           @unique
  broadcastTxHash       String?
  confirmations         Int              @default(0)
  requestedAt           DateTime         @default(now())
  reviewedBy            String?          @db.Uuid
  reviewedAt            DateTime?
  broadcastAt           DateTime?
  confirmedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  holdLedgerEntryId     String?          @unique @db.Uuid
  finalizeLedgerEntryId String?          @unique @db.Uuid
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  requester           Profile      @relation("WithdrawalRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer            Profile?     @relation("WithdrawalReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  wallet              UserWallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  holdLedgerEntry     LedgerEntry? @relation("WithdrawalHoldEntry", fields: [holdLedgerEntryId], references: [id], onDelete: SetNull)
  finalizeLedgerEntry LedgerEntry? @relation("WithdrawalFinalizeEntry", fields: [finalizeLedgerEntryId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([asset, status, createdAt])
  @@index([userId, asset, createdAt])
  @@index([walletId, status, createdAt])
  @@index([walletId, asset, status, createdAt])
}

model KycProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @db.Uuid
  status              KycStatus @default(not_submitted)
  tier                String    @default("basic")
