  verifiedAt         DateTime?
  rejectionReason    String?
  submittedAt        DateTime                @default(now())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  reviewNotes        String?
  user               Profile                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userQuest          UserQuest               @relation(fields: [userQuestId], references: [id], onDelete: Cascade)

  @@index([userId, verificationStatus])
  @@index([userQuestId, submittedAt])
  @@index([verificationStatus, submittedAt])
}

model Mention {
  id                     String                @id @default(uuid()) @db.Uuid
  mentionedUserId        String                @db.Uuid
  commentId              String?               @db.Uuid
  communityPostId        String?               @db.Uuid
  communityPostCommentId String?               @db.Uuid
  mentionText            String
  createdAt              DateTime              @default(now())
  comment                Comment?              @relation("CommentMentions", fields: [commentId], references: [id], onDelete: Cascade)
  communityPostComment   CommunityPostComment? @relation("CommunityPostCommentMentions", fields: [communityPostCommentId], references: [id], onDelete: Cascade)
  communityPost          CommunityPost?        @relation("CommunityPostMentions", fields: [communityPostId], references: [id], onDelete: Cascade)
  mentionedUser          Profile               @relation("UserMentioned", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId, createdAt])
  @@index([commentId])
  @@index([communityPostId])
  @@index([communityPostCommentId])
}

model UserLevel {
  id                    String              @id @default(uuid()) @db.Uuid
  slug                  String              @unique
  name                  String
  description           String
  iconUrl               String
  level                 Int                 @unique
  requiredBnp           BigInt              @default(0)
  requiredComments      Int                 @default(0)
  requiredDaysActive    Int                 @default(0)
  requiredQuests        Int                 @default(0)
  requiredUpdates       Int                 @default(0)
  requiredProjects      Int                 @default(0)
  color                 String?
  isActive              Boolean             @default(true)
  sortOrder             Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  usersWithCurrentLevel Profile[]           @relation("ProfileCurrentLevel")
  usersAtLevel          UserLevelProgress[]

  @@index([level, isActive])
  @@index([requiredBnp])
  @@index([sortOrder])
}

model UserLevelProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid
  currentLevelId       String    @db.Uuid
  achievedAt           DateTime  @default(now())
  totalBnpEarned       BigInt    @default(0)
  totalComments        Int       @default(0)
  totalDaysActive      Int       @default(0)
  totalQuestsCompleted Int       @default(0)
  totalUpdates         Int       @default(0)
  totalProjects        Int       @default(0)
  lastRecalculatedAt   DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  currentLevel         UserLevel @relation(fields: [currentLevelId], references: [id])
  user                 Profile   @relation("UserLevelProgressRelation", fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentLevelId, achievedAt])
  @@index([totalBnpEarned])
  @@index([userId, lastRecalculatedAt])
}

