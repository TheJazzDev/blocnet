  questId     String      @db.Uuid
  status      QuestStatus @default(not_started)
  progress    Int         @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

