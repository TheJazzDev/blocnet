  updatedAt       DateTime @updatedAt

  @@index([provider, updatedAt])
  @@index([createdAt])
}

model TipCurrency {
  code                    String          @id
  name                    String
  symbol                  String
  decimals                Int
  kind                    TipCurrencyKind @default(points)
  isEnabled               Boolean         @default(true)
  isActiveTippingCurrency Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  feeConfig       TipFeeConfig?
  accounts        TipAccount[]
  transactions    TipTransaction[]
  conversionsFrom TipConversion[]  @relation("TipConversionFromCurrency")
  conversionsTo   TipConversion[]  @relation("TipConversionToCurrency")

  @@index([isActiveTippingCurrency, isEnabled])
}

model TipFeeConfig {
  id            String   @id @default(uuid()) @db.Uuid
  currencyCode  String   @unique
  feeBps        Int      @default(0)
  minTipAtomic  BigInt   @default(1)
  maxTipAtomic  BigInt?
  minFeeAtomic  BigInt   @default(0)
  maxFeeAtomic  BigInt?
  senderPaysFee Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  currency TipCurrency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)
}

model TipAccount {
  id            String         @id @default(uuid()) @db.Uuid
  accountType   TipAccountType
  ownerRef      String
  userId        String?        @db.Uuid
  currencyCode  String
  balanceAtomic BigInt         @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user                 Profile?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency             TipCurrency      @relation(fields: [currencyCode], references: [code], onDelete: Cascade)
  sentTransactions     TipTransaction[] @relation("TipTxnSenderAccount")
  receivedTransactions TipTransaction[] @relation("TipTxnRecipientAccount")
  feeTransactions      TipTransaction[] @relation("TipTxnFeeAccount")

  @@unique([accountType, ownerRef, currencyCode])
  @@index([userId, currencyCode])
  @@index([currencyCode, accountType])
}

model TipTransaction {
  id                 String             @id @default(uuid()) @db.Uuid
  type               TipTransactionType @default(tip)
  senderAccountId    String             @db.Uuid
  recipientAccountId String             @db.Uuid
  feeAccountId       String?            @db.Uuid
  senderUserId       String             @db.Uuid
  recipientUserId    String             @db.Uuid
  currencyCode       String
  amountAtomic       BigInt
  feeAtomic          BigInt             @default(0)
  totalDebitAtomic   BigInt
  note               String?
  contextType        String?
  contextId          String?
  idempotencyKey     String             @unique
  metadata           Json?
  createdAt          DateTime           @default(now())

  senderAccount    TipAccount  @relation("TipTxnSenderAccount", fields: [senderAccountId], references: [id], onDelete: Restrict)
  recipientAccount TipAccount  @relation("TipTxnRecipientAccount", fields: [recipientAccountId], references: [id], onDelete: Restrict)
  feeAccount       TipAccount? @relation("TipTxnFeeAccount", fields: [feeAccountId], references: [id], onDelete: SetNull)
  sender           Profile     @relation("TipTxnSenderUser", fields: [senderUserId], references: [id], onDelete: Restrict)
  recipient        Profile     @relation("TipTxnRecipientUser", fields: [recipientUserId], references: [id], onDelete: Restrict)
  currency         TipCurrency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@index([senderUserId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([currencyCode, createdAt])
}

model TipConversion {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  fromCurrencyCode String
  toCurrencyCode   String
  amountInAtomic   BigInt
  amountOutAtomic  BigInt
  rateNumerator    BigInt
  rateDenominator  BigInt
  idempotencyKey   String   @unique
  metadata         Json?
  createdAt        DateTime @default(now())

  user         Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCurrency TipCurrency @relation("TipConversionFromCurrency", fields: [fromCurrencyCode], references: [code], onDelete: Restrict)
  toCurrency   TipCurrency @relation("TipConversionToCurrency", fields: [toCurrencyCode], references: [code], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([fromCurrencyCode, toCurrencyCode, createdAt])
}

model MiningSession {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @db.Uuid
  startsAt                DateTime
  endsAt                  DateTime
  claimedAt               DateTime?
  basePointsPerCycle      Int
  activeReferralsSnapshot Int
  boostBpsSnapshot        Int
  effectivePointsPerCycle Int
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user              Profile                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger            MiningPointLedger[]
  hourlyCheckpoints MiningHourlyCheckpoint[]

  @@index([userId, createdAt])
  @@index([userId, claimedAt])
  @@index([userId, startsAt])
}

model MiningPointLedger {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  sessionId String?           @db.Uuid
  source    MiningPointSource
  points    Int
  metadata  Json?
  createdAt DateTime          @default(now())

  user    Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session MiningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model MiningHourlyCheckpoint {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @db.Uuid
  sessionId               String    @db.Uuid
  hourIndex               Int
  hourStartAt             DateTime
  hourEndAt               DateTime
  activeReferralsSnapshot Int
  boostBpsSnapshot        Int
  points                  Int
  claimedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user    Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session MiningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, hourIndex])
  @@index([userId, hourEndAt])
  @@index([sessionId, claimedAt])
}

model MiningConfig {
  id                        String   @id
  enabled                   Boolean  @default(true)
  referralsEnabled          Boolean  @default(true)
  cycleHours                Int      @default(24)
  basePointsPerCycle        Int      @default(120)
  perActiveReferralBoostBps Int      @default(500)
  maxBoostBps               Int      @default(10000)
  activeReferralWindowHours Int      @default(168)
  referralBindWindowHours   Int      @default(24)
  updatedAt                 DateTime @updatedAt
}

model Badge {
