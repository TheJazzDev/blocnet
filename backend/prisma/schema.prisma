generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                                 String                               @id @db.Uuid
  email                              String                               @unique
  displayName                        String?
  avatarUrl                          String?
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime                             @updatedAt
  username                           String?                              @unique
  bio                                String?
  homeFeedLastSeenAt                 DateTime?
  isDeactivated                      Boolean                              @default(false)
  deactivatedAt                      DateTime?
  deactivatedBy                      String?                              @db.Uuid
  deactivationReason                 String?
  referralCode                       String?                              @unique
  referredById                       String?                              @db.Uuid
  referredAt                         DateTime?
  miningClaimedPoints                BigInt                               @default(0)
  previousUsername                   String?
  previousDisplayName                String?
  previousAvatarUrl                  String?
  previousBio                        String?
  primaryBadgeId                     String?                              @db.Uuid
  currentLevelId                     String?                              @db.Uuid
  communityWarnCount                 Int                                  @default(0)
  communityLastWarnedAt              DateTime?
  communityMutedUntil                DateTime?
  communitySuspendedUntil            DateTime?
  communityPostingRestrictedUntil    DateTime?
  communityCommentingRestrictedUntil DateTime?
  adminApplications                  AdminApplication[]                   @relation("AdminApplicationApplicant")
  adminTotpCredential                AdminTotpCredential?
  adminTotpEnrollmentChallenge       AdminTotpEnrollmentChallenge?
  adminTotpRecoveryCodes             AdminTotpRecoveryCode[]
  adminTwoFactorSessions             AdminTwoFactorSession[]
  audits                             AuditLog[]                           @relation("ActorAuditLogs")
  bookmarks                          Bookmark[]
  authoredComments                   Comment[]                            @relation("AuthoredComments")
  moderatedComments                  Comment[]                            @relation("CommentModerator")
  commentReactions                   CommentReaction[]                    @relation("CommentReactionUser")
  issuedCommunityModerationActions   CommunityModerationAction[]          @relation("CommunityActionActor")
  receivedCommunityModerationActions CommunityModerationAction[]          @relation("CommunityActionTarget")
  filedCommunityReports              CommunityModerationReport[]          @relation("CommunityReportReporter")
  reviewedCommunityReports           CommunityModerationReport[]          @relation("CommunityReportReviewer")
  targetedCommunityReports           CommunityModerationReport[]          @relation("CommunityReportTargetUser")
  communityPosts                     CommunityPost[]                      @relation("CommunityPostAuthor")
  moderatedCommunityPosts            CommunityPost[]                      @relation("CommunityPostModerator")
  communityPostComments              CommunityPostComment[]               @relation("CommunityPostCommentAuthor")
  moderatedCommunityPostComments     CommunityPostComment[]               @relation("CommunityPostCommentModerator")
  communityPostCommentReactions      CommunityPostCommentReaction[]       @relation("CommunityPostCommentReactionUser")
  communityPostReactions             CommunityPostReaction[]              @relation("CommunityPostReactionUser")
  filedCommunityAppeals              CommunityReportAppeal[]              @relation("AppealAppealer")
  reviewedCommunityAppeals           CommunityReportAppeal[]              @relation("AppealReviewer")
  deviceTokens                       DeviceToken[]
  edgeDecisions                      EdgeDecision[]
  edgeEngagements                    EdgeEngagement[]
  edgeFeedback                       EdgeFeedback[]
  reviewedKycProfiles                KycProfile[]                         @relation("KycReviewer")
  kycProfile                         KycProfile?
  ledgerAccounts                     LedgerAccount[]
  mentions                           Mention[]                            @relation("UserMentioned")
  miningHourlyCheckpoints            MiningHourlyCheckpoint[]
  miningPointLedgerEntries           MiningPointLedger[]
  miningSessions                     MiningSession[]
  actorNotifications                 Notification[]                       @relation("NotificationActor")
  notifications                      Notification[]
  currentLevel                       UserLevel?                           @relation("ProfileCurrentLevel", fields: [currentLevelId], references: [id])
  primaryBadge                       Badge?                               @relation("ProfilePrimaryBadge", fields: [primaryBadgeId], references: [id])
  referrer                           Profile?                             @relation("ProfileReferrer", fields: [referredById], references: [id])
  referrals                          Profile[]                            @relation("ProfileReferrer")
  moderatedProjects                  Project[]                            @relation("ProjectModerator")
  ownedProjects                      Project[]                            @relation("OwnedProjects")
  follows                            ProjectFollow[]
  hunterAssignments                  ProjectHunter[]
  hunterInvites                      ProjectHunterInvite[]                @relation("InviteHunter")
  sentInvites                        ProjectHunterInvite[]                @relation("InviteSender")
  reviewedInvites                    ProjectHunterInvite[]                @relation("InviteReviewer")
  projectProposals                   ProjectProposal[]                    @relation("ProjectProposalApplicant")
  reviewedProposals                  ProjectProposal[]                    @relation("ProjectProposalReviewer")
  questSubmissions                   QuestSubmission[]
  tipAccounts                        TipAccount[]
  tipConversions                     TipConversion[]
  tipTransactionsReceived            TipTransaction[]                     @relation("TipTxnRecipientUser")
  tipTransactionsSent                TipTransaction[]                     @relation("TipTxnSenderUser")
  authoredUpdates                    Update[]                             @relation("AuthoredUpdates")
  moderatedUpdates                   Update[]                             @relation("UpdateModerator")
  grantedBadges                      UserBadge[]                          @relation("BadgeGrantor")
  earnedBadges                       UserBadge[]                          @relation("UserEarnedBadges")
  blockedByUsers                     UserBlock[]                          @relation("BlockedUser")
  blockedUsers                       UserBlock[]                          @relation("BlockerUser")
  followerLinks                      UserFollow[]                         @relation("UserFollowFollowee")
  followingLinks                     UserFollow[]                         @relation("UserFollowFollower")
  levelProgress                      UserLevelProgress?                   @relation("UserLevelProgressRelation")
  notificationCategoryPreferences    UserNotificationCategoryPreference[]
  notificationSettings               UserNotificationSettings?
  notificationTypeOverrides          UserNotificationTypeOverride[]
  userQuests                         UserQuest[]
  roles                              UserRole[]
  wallet                             UserWallet?
  reviewedWithdrawals                WithdrawalRequest[]                  @relation("WithdrawalReviewer")
  withdrawalRequests                 WithdrawalRequest[]                  @relation("WithdrawalRequester")

  @@index([referredById])
  @@index([primaryBadgeId])
  @@index([currentLevelId])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  reason    String?
  createdAt DateTime @default(now())
  blocked   Profile  @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   Profile  @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      RoleName
  grantedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model Project {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  slug             String                @unique
  description      String
  status           ProjectStatus         @default(active)
  ownerAdminId     String                @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  normalizedName   String?               @unique
  symbol           String?               @unique
  websiteDomain    String?               @unique
  websiteUrl       String?
  primaryTagId     String                @db.Uuid
  moderatedBy      String?               @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  edgeDecisions    EdgeDecision[]
  notifications    Notification[]
  moderator        Profile?              @relation("ProjectModerator", fields: [moderatedBy], references: [id])
  ownerAdmin       Profile               @relation("OwnedProjects", fields: [ownerAdminId], references: [id])
  primaryTag       PrimaryTag            @relation(fields: [primaryTagId], references: [id])
  follows          ProjectFollow[]
  hunters          ProjectHunter[]
  invites          ProjectHunterInvite[]
  proposals        ProjectProposal[]
  secondaryTags    ProjectSecondaryTag[]
  updates          Update[]

  @@index([ownerAdminId])
  @@index([status, createdAt])
}

model ProjectHunter {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  hunterId   String   @db.Uuid
  assignedBy String   @db.Uuid
  createdAt  DateTime @default(now())
  hunter     Profile  @relation(fields: [hunterId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, hunterId])
  @@index([hunterId])
}

model ProjectHunterInvite {
  id         String       @id @default(uuid()) @db.Uuid
  projectId  String       @db.Uuid
  hunterId   String       @db.Uuid
  invitedBy  String       @db.Uuid
  note       String?
  status     InviteStatus @default(pending)
  reviewedBy String?      @db.Uuid
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  hunter     Profile      @relation("InviteHunter", fields: [hunterId], references: [id], onDelete: Cascade)
  inviter    Profile      @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer   Profile?     @relation("InviteReviewer", fields: [reviewedBy], references: [id])

  @@unique([projectId, hunterId])
  @@index([hunterId, status])
  @@index([projectId, status])
}

model ProjectProposal {
  id               String                @id @default(uuid()) @db.Uuid
  applicantId      String                @db.Uuid
  name             String
  normalizedName   String
  symbol           String?
  websiteUrl       String?
  websiteDomain    String?
  description      String
  reason           String?
  status           ProjectProposalStatus @default(pending)
  reviewerId       String?               @db.Uuid
  reviewNote       String?
  reviewedAt       DateTime?
  createdProjectId String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  primaryTagId     String                @db.Uuid
  applicant        Profile               @relation("ProjectProposalApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  createdProject   Project?              @relation(fields: [createdProjectId], references: [id])
  primaryTag       PrimaryTag            @relation(fields: [primaryTagId], references: [id])
  reviewer         Profile?              @relation("ProjectProposalReviewer", fields: [reviewerId], references: [id])

  @@index([applicantId, status])
  @@index([status, createdAt])
  @@index([normalizedName, status])
}

model Update {
  id               String               @id @default(uuid()) @db.Uuid
  projectId        String               @db.Uuid
  authorId         String               @db.Uuid
  urgency          UpdateUrgency
  title            String
  contentMd        String
  status           UpdateStatus         @default(published)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  moderatedBy      String?              @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  comments         Comment[]
  edgeDecisions    EdgeDecision[]
  edgeEngagements  EdgeEngagement[]
  notifications    Notification[]
  author           Profile              @relation("AuthoredUpdates", fields: [authorId], references: [id], onDelete: Cascade)
  moderator        Profile?             @relation("UpdateModerator", fields: [moderatedBy], references: [id])
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secondaryTags    UpdateSecondaryTag[]

  @@index([projectId, urgency])
  @@index([authorId])
  @@index([status, createdAt])
}

model PrimaryTag {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  projects  Project[]
  proposals ProjectProposal[]
}

model SecondaryTag {
  id        String                @id @default(uuid()) @db.Uuid
  name      String                @unique
  slug      String                @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  projects  ProjectSecondaryTag[]
  updates   UpdateSecondaryTag[]
}

model ProjectSecondaryTag {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @db.Uuid
  secondaryTagId String       @db.Uuid
  createdAt      DateTime     @default(now())
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secondaryTag   SecondaryTag @relation(fields: [secondaryTagId], references: [id])

  @@unique([projectId, secondaryTagId])
  @@index([secondaryTagId])
}

model UpdateSecondaryTag {
  id             String       @id @default(uuid()) @db.Uuid
  updateId       String       @db.Uuid
  secondaryTagId String       @db.Uuid
  createdAt      DateTime     @default(now())
  secondaryTag   SecondaryTag @relation(fields: [secondaryTagId], references: [id])
  update         Update       @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([updateId, secondaryTagId])
  @@index([secondaryTagId])
}

model Comment {
  id               String                  @id @default(uuid()) @db.Uuid
  updateId         String                  @db.Uuid
  authorId         String                  @db.Uuid
  content          String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  status           ContentModerationStatus @default(active)
  moderatedBy      String?                 @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  replyToId        String?                 @db.Uuid
  author           Profile                 @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)
  moderator        Profile?                @relation("CommentModerator", fields: [moderatedBy], references: [id])
  replyTo          Comment?                @relation("CommentReplies", fields: [replyToId], references: [id])
  replies          Comment[]               @relation("CommentReplies")
  update           Update                  @relation(fields: [updateId], references: [id], onDelete: Cascade)
  reactions        CommentReaction[]
  mentions         Mention[]               @relation("CommentMentions")

  @@index([updateId, status, createdAt])
  @@index([authorId])
  @@index([status, createdAt])
  @@index([replyToId])
}

model CommentReaction {
  id        String                @id @default(uuid()) @db.Uuid
  commentId String                @db.Uuid
  userId    String                @db.Uuid
  createdAt DateTime              @default(now())
  kind      CommunityReactionKind @default(like)
  comment   Comment               @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      Profile               @relation("CommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, kind])
  @@index([userId, createdAt])
  @@index([commentId, kind])
}

model ProjectFollow {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @db.Uuid
  userId          String        @db.Uuid
  createdAt       DateTime      @default(now())
  alertMinUrgency UpdateUrgency @default(low)
  mutedUntil      DateTime?
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, alertMinUrgency])
  @@index([projectId, mutedUntil])
}

model UserFollow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @db.Uuid
  followeeId String   @db.Uuid
  createdAt  DateTime @default(now())
  followee   Profile  @relation("UserFollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   Profile  @relation("UserFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model CommunityPost {
  id               String                  @id @default(uuid()) @db.Uuid
  authorId         String                  @db.Uuid
  topic            CommunityTopic          @default(general)
  content          String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  status           ContentModerationStatus @default(active)
  moderatedBy      String?                 @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  bookmarks        Bookmark[]
  author           Profile                 @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderator        Profile?                @relation("CommunityPostModerator", fields: [moderatedBy], references: [id])
  comments         CommunityPostComment[]
  reactions        CommunityPostReaction[]
  mentions         Mention[]               @relation("CommunityPostMentions")

  @@index([topic, status, createdAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model CommunityPostComment {
  id               String                         @id @default(uuid()) @db.Uuid
  postId           String                         @db.Uuid
  authorId         String                         @db.Uuid
  content          String
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  status           ContentModerationStatus        @default(active)
  moderatedBy      String?                        @db.Uuid
  moderatedAt      DateTime?
  moderationReason String?
  replyToId        String?                        @db.Uuid
  author           Profile                        @relation("CommunityPostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderator        Profile?                       @relation("CommunityPostCommentModerator", fields: [moderatedBy], references: [id])
  post             CommunityPost                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyTo          CommunityPostComment?          @relation("CommunityPostCommentReplies", fields: [replyToId], references: [id])
  replies          CommunityPostComment[]         @relation("CommunityPostCommentReplies")
  reactions        CommunityPostCommentReaction[]
  mentions         Mention[]                      @relation("CommunityPostCommentMentions")

  @@index([postId, status, createdAt])
  @@index([authorId])
  @@index([status, createdAt])
  @@index([replyToId])
}

model CommunityPostCommentReaction {
  id        String                @id @default(uuid()) @db.Uuid
  commentId String                @db.Uuid
  userId    String                @db.Uuid
  createdAt DateTime              @default(now())
  kind      CommunityReactionKind @default(like)
  comment   CommunityPostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      Profile               @relation("CommunityPostCommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, kind])
  @@index([userId, createdAt])
  @@index([commentId, kind])
}

model CommunityPostReaction {
  id        String                @id @default(uuid()) @db.Uuid
  postId    String                @db.Uuid
  userId    String                @db.Uuid
  kind      CommunityReactionKind @default(like)
  createdAt DateTime              @default(now())
  post      CommunityPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile               @relation("CommunityPostReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, kind])
  @@index([userId, createdAt])
  @@index([postId, kind])
}

model Bookmark {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  communityPostId String        @db.Uuid
  createdAt       DateTime      @default(now())
  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)
  user            Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityPostId])
  @@index([userId, createdAt])
  @@index([communityPostId])
}

model CommunityModerationReport {
  id             String                              @id @default(uuid()) @db.Uuid
  reporterId     String                              @db.Uuid
  targetType     CommunityModerationReportTargetType
  targetId       String                              @db.Uuid
  targetUserId   String?                             @db.Uuid
  reason         String
  details        String?
  status         CommunityModerationReportStatus     @default(open)
  reviewedById   String?                             @db.Uuid
  reviewedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt
  actions        CommunityModerationAction[]
  reporter       Profile                             @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer       Profile?                            @relation("CommunityReportReviewer", fields: [reviewedById], references: [id])
  targetUser     Profile?                            @relation("CommunityReportTargetUser", fields: [targetUserId], references: [id])
  appeals        CommunityReportAppeal[]

  @@index([status, createdAt])
  @@index([targetType, targetId, status])
  @@index([reporterId, createdAt])
  @@index([targetUserId, createdAt])
}

model CommunityModerationAction {
  id            String                        @id @default(uuid()) @db.Uuid
  actionType    CommunityModerationActionType
  actorId       String                        @db.Uuid
  targetUserId  String                        @db.Uuid
  reportId      String?                       @db.Uuid
  reason        String?
  previousValue DateTime?
  nextValue     DateTime?
  metadata      Json?
  createdAt     DateTime                      @default(now())
  actor         Profile                       @relation("CommunityActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  report        CommunityModerationReport?    @relation(fields: [reportId], references: [id])
  targetUser    Profile                       @relation("CommunityActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([actionType, createdAt])
  @@index([reportId])
}

model CommunityReportAppeal {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId     String                    @db.Uuid
  appealerId   String                    @db.Uuid
  reason       String
  status       CommunityAppealStatus     @default(pending)
  reviewedById String?                   @db.Uuid
  reviewedAt   DateTime?
  reviewNotes  String?
  decision     CommunityAppealDecision?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @default(now()) @updatedAt
  appealer     Profile                   @relation("AppealAppealer", fields: [appealerId], references: [id], onDelete: Cascade)
  report       CommunityModerationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewedBy   Profile?                  @relation("AppealReviewer", fields: [reviewedById], references: [id])

  @@index([appealerId])
  @@index([status])
  @@index([createdAt])
  @@index([reportId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  projectId   String?          @db.Uuid
  updateId    String?          @db.Uuid
  urgency     UpdateUrgency?
  title       String
  body        String
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  actorUserId String?          @db.Uuid
  payload     Json?
  deeplink    String?
  dedupeKey   String?
  actor       Profile?         @relation("NotificationActor", fields: [actorUserId], references: [id])
  project     Project?         @relation(fields: [projectId], references: [id])
  update      Update?          @relation(fields: [updateId], references: [id])
  user        Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
  @@index([projectId])
}

model UserNotificationSettings {
  userId             String        @id @db.Uuid
  masterEnabled      Boolean       @default(true)
  digestEmailEnabled Boolean       @default(true)
  digestCadence      DigestCadence @default(daily)
  digestHourLocal    Int           @default(8)
  digestMinuteLocal  Int           @default(0)
  timezone           String        @default("UTC")
  lastDigestSentAt   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotificationCategoryPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId, category])
}

model UserNotificationTypeOverride {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  enabled   Boolean
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, type])
}

model EdgeDecision {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  decisionId         String
  updateId           String           @db.Uuid
  projectId          String           @db.Uuid
  edgeScore          Float
  recommendedAction  EdgeAction
  reasonCodes        Json?
  explanationPreview String?
  urgencyScore       Float
  recencyScore       Float
  relevanceScore     Float
  noveltyScore       Float
  penaltyScore       Float
  generatedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  mlActionability    Float?
  mlInsights         Json?
  mlProvider         String?
  mlQuality          Float?
  mlSentiment        String?
  mlTopics           Json?
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  update             Update           @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user               Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagements        EdgeEngagement[]
  feedbacks          EdgeFeedback[]

  @@unique([userId, decisionId])
  @@index([userId, generatedAt])
  @@index([projectId, generatedAt])
  @@index([updateId, generatedAt])
  @@index([recommendedAction, generatedAt])
}

model EdgeFeedback {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  decisionRecordId String       @db.Uuid
  decisionId       String
  action           EdgeAction
  context          Json?
  createdAt        DateTime     @default(now())
  decision         EdgeDecision @relation(fields: [decisionRecordId], references: [id], onDelete: Cascade)
  user             Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
