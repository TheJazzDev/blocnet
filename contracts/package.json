{
  "name": "blocnet-contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy-bnt.js --network bscTestnet",
    "verify:testnet": "hardhat run scripts/verify-bnt.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy-bnt.js --network bscMainnet",
    "verify:mainnet": "hardhat run scripts/verify-bnt.js --network bscMainnet",
    "export:artifact": "node scripts/export-artifact.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.2.3",
    "hardhat": "^2.26.5"
  }
}
